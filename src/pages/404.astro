---
import Base from '../layouts/Base.astro';
import { sitePath } from '../lib/catalog.mjs';
---
<Base title="页面未找到 — TechYan Demo"><section class="hero"><div class="eyebrow">404 / PAGE NOT FOUND</div><h1>换一条路径，<br/><span>继续探索。</span></h1><p class="hero-copy">这个地址没有对应的演示。你可以从项目索引重新开始。</p><div class="hero-actions" style="margin-top:28px"><a class="primary-button" href={sitePath('', import.meta.env.BASE_URL)}>返回项目索引 →</a></div></section></Base>
