---
const { id, featured = false } = Astro.props;
const titles = { sflow: 'TREE / BUILD / CONNECT / RUN', pvkit: 'CAPTURE / AXI4 + CXL', wavedbg: 'QUESTION / WINDOW / EVIDENCE', 'bus-protocol-lab': 'MEMORY / TRANSACTION / PACKET', pg_gen: 'PROGRAMMING GUIDE / PREVIEW', uvm_wiki: 'DEMO_ENV / ARCHITECTURE', svip: 'PROTOCOL / COMPONENTS', xpggen: 'XPGGEN / TERMINAL', xDCT: 'TOP INTERFACE / SEMANTIC DIFF' };
---
<div class:list={['project-visual', `visual-${id}`, { 'visual-featured': featured }]} aria-hidden="true">
  <div class="visual-topline"><span>{titles[id]}</span><span class="visual-dots">···</span></div>
  {id === 'sflow' && <svg viewBox="0 0 480 210"><g fill="var(--surface)" stroke="var(--line)"><rect x="25" y="38" width="120" height="48" rx="5"/><rect x="25" y="116" width="120" height="48" rx="5"/><rect x="206" y="67" width="118" height="68" rx="5"/><rect x="382" y="77" width="74" height="48" rx="5"/></g><g fill="none" stroke="var(--project-accent)"><path d="M145 62h30v28h31M145 140h30v-28h31M324 101h58"/></g><g class="mono-label" fill="var(--muted)" text-anchor="middle"><text x="85" y="66">IP / LIBRARY</text><text x="85" y="144">SOC TREE</text><text x="265" y="94">sflow + SC</text><text x="265" y="116">publish → BIA</text><text x="419" y="105">DUT</text></g><text x="25" y="194" class="mono-label" fill="var(--project-accent)">INDEPENDENT REPOS. REPRODUCIBLE BUILDS.</text></svg>}
  {id === 'wavedbg'  && <svg viewBox="0 0 480 210"><g stroke="var(--line)" fill="none"><path d="M96 25v162m80-162v162m80-162v162m80-162v162m80-162v162M96 65h340M96 113h340M96 161h340"/></g><rect x="251" y="24" width="90" height="161" rx="3" fill="var(--project-accent)" opacity=".08"/><g fill="var(--muted)" class="mono-label"><text x="26" y="57">clk</text><text x="26" y="105">valid</text><text x="26" y="153">ready</text></g><g stroke="var(--project-accent)" stroke-width="2" fill="none"><path d="M96 57h40V35h40v22h40V35h40v22h40V35h40v22h40V35h40v22h20M96 105h80V83h160v22h100M96 153h160v-22h160v22h20"/></g><path d="M251 24v162m90-162v162" stroke="var(--project-accent)" stroke-dasharray="4 4" opacity=".7"/><rect x="265" y="165" width="135" height="23" rx="3" fill="var(--surface)" stroke="var(--line)"/><text x="276" y="181" class="mono-label" fill="var(--project-accent)">OVERVIEW → EVIDENCE</text></svg>}
  {id === 'pvkit' && <svg viewBox="0 0 480 210" class="wave-diagram"><g stroke="currentColor" opacity=".12"><path d="M25 35h430M25 75h430M25 115h430M25 155h430M25 195h430M55 15v180M135 15v180M215 15v180M295 15v180M375 15v180M455 15v180"/></g><g class="mono-label" fill="currentColor" opacity=".45"><text x="25" y="24">GB/s</text><text x="24" y="207">0</text><text x="420" y="207">24 μs</text></g><path d="M25 152h28l10-38h32l12 23h24l12-75h36l12 32h24l11-49h31l11 55h28l10-29h28l11 43h25l12-58h34l11 42h29l12-16h25" fill="none" stroke="var(--accent)" stroke-width="2.3"/><path d="M25 174h41l12-19h30l11 10h22l12-45h35l11 26h32l11-38h30l11 28h29l12-40h30l11 61h28l12-33h35l12 21h34" fill="none" stroke="#a5a1ee" stroke-width="2"/><path d="M287 15v180" stroke="var(--accent)" stroke-dasharray="4 5" opacity=".6"/><rect x="292" y="25" width="115" height="27" rx="4" fill="var(--surface)" stroke="var(--line)"/><text x="301" y="43" class="mono-label" fill="var(--accent)">12.8 μs / 2.41</text><g class="mono-label"><circle cx="32" cy="57" r="3" fill="var(--accent)"/><text x="42" y="61" fill="var(--muted)">Read</text><circle cx="32" cy="76" r="3" fill="#a5a1ee"/><text x="42" y="80" fill="var(--muted)">Write</text></g></svg>}
  {id === 'bus-protocol-lab' && <svg viewBox="0 0 480 210"><g stroke="var(--line)" fill="var(--surface)"><rect x="28" y="39" width="94" height="130" rx="5"/><rect x="184" y="56" width="112" height="46" rx="5"/><rect x="184" y="120" width="112" height="46" rx="5"/><rect x="358" y="36" width="94" height="35" rx="5"/><rect x="358" y="86" width="94" height="35" rx="5"/><rect x="358" y="136" width="94" height="35" rx="5"/></g><g class="mono-label" fill="var(--muted)" text-anchor="middle"><text x="75" y="26">MEMORY</text><text x="240" y="39">AXI BURST</text><text x="405" y="24">PCIE TLP</text><text x="240" y="84">AW / W</text><text x="240" y="148">AR / R</text><text x="405" y="58">MWr #01</text><text x="405" y="108">MWr #02</text><text x="405" y="158">CplD #03</text></g><g fill="var(--project-accent)" opacity=".8"><rect x="39" y="55" width="72" height="14" rx="2"/><rect x="39" y="76" width="72" height="14" rx="2"/><rect x="39" y="97" width="72" height="14" rx="2"/><rect x="39" y="118" width="72" height="14" rx="2"/><rect x="39" y="139" width="40" height="14" rx="2"/></g><g stroke="var(--project-accent)" fill="none" opacity=".7"><path d="M122 76h32v3h30m-62 55h32v9h30M296 78h31V54h31m-62 24h31v26h31m-62 40h31v10h31"/></g></svg>}
  {id === 'pg_gen' && <div class="code-preview"><div class="code-row"><span>01</span><b>flow</b><i>demo.startup</i></div><div class="code-row"><span>02</span><b>write</b><i>CTRL.ENABLE = 1</i></div><div class="code-row"><span>03</span><b>rmw</b><i>CONFIG.MODE = 0x3</i></div><div class="code-row"><span>04</span><b>poll</b><i>STATUS.READY == 1</i></div><div class="code-row"><span>05</span><b>export</b><i>JSON · CSV · SV</i></div></div>}
  {id === 'uvm_wiki' && <svg viewBox="0 0 480 210"><g fill="none" stroke="var(--project-accent)" opacity=".55"><path d="M240 66v23H95v34m145-57v57m0-34h145v34M95 151v22h145v-22m0 22h145v-22"/></g><g fill="var(--surface)" stroke="var(--line)"><rect x="184" y="24" width="112" height="42" rx="5"/><rect x="39" y="123" width="112" height="38" rx="5"/><rect x="184" y="123" width="112" height="38" rx="5"/><rect x="329" y="123" width="112" height="38" rx="5"/></g><g class="mono-label" fill="var(--muted)" text-anchor="middle"><text x="240" y="50">demo_env</text><text x="95" y="147">agent</text><text x="240" y="147">scoreboard</text><text x="385" y="147">coverage</text></g><g fill="var(--project-accent)"><circle cx="95" cy="123" r="3"/><circle cx="240" cy="123" r="3"/><circle cx="385" cy="123" r="3"/></g><text x="206" y="199" class="mono-label" fill="var(--project-accent)">TLM CONNECTED</text></svg>}
  {id === 'svip' && <div class="component-map"><div class="map-core"><span>UVM</span><small>VERIFICATION IP</small></div><div class="map-protocols"><span>AXI4</span><span>APB</span><span>JTAG</span><span>SPI</span></div><div class="map-controls"><span>clock</span><span>reset</span><span>signal</span></div></div>}
  {id === 'xpggen' && <div class="terminal-preview"><div><em>❯</em> xpggen <b>--demo</b></div><div class="terminal-rule">REGISTER CATALOG <span>PG STEPS</span></div><div class="terminal-selected">› DEMO_CTRL <span>① write</span></div><div>  DEMO_STATUS <span>② poll</span></div><div>  DEMO_CONFIG <span>③ delay</span></div><div class="terminal-bottom">/ search <span>↵ select</span><span>e export</span></div></div>}
  {id === 'xDCT' && <div class="diff-preview"><div class="diff-header"><span>top_v1.sv</span><span>top_v2.sv</span></div><div class="diff-minus">− input logic [15:0] rx_data</div><div class="diff-plus">+ input logic [31:0] rx_data</div><div class="diff-neutral">  WIDTH_CHANGED</div><div class="diff-summary"><span>6 breaking</span><span>1 added</span><span>3 order-only</span></div></div>}
</div>

