{
  "name": "techyan-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build-site.mjs",
    "build:github": "node scripts/build-site.mjs --github",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:site": "python scripts/check_site.py dist",
    "test:browser": "playwright test",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name techyan-demo"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.4.5",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "wrangler": "^4.45.0"
  }
}
